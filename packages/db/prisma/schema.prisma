generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "esm"
}

datasource db {
  provider = "postgresql"
}

enum ContactInterest {
  AI_AGENTS
  VIBE_CODING
  AI_SEO
  WEBSITE_BUILDER
  OTHER
}

enum ContactStatus {
  NEW
  READ
  ARCHIVED
}

/// Messages sent from the contact form on appamora.com.
model ContactMessage {
  id        String          @id @default(cuid())
  name      String
  email     String
  interest  ContactInterest
  message   String
  locale    String
  status    ContactStatus   @default(NEW)
  createdAt DateTime        @default(now())

  @@index([status, createdAt])
}

// ─── Authentication (Better Auth) ───────────────────────────────────────────

enum Role {
  USER
  ADMIN
}

model User {
  id            String    @id
  name          String
  email         String    @unique
  emailVerified Boolean   @default(false)
  image         String?
  role          Role      @default(USER)
  /// The business account this login belongs to (clients only).
  clientId      String?
  client        Client?   @relation(fields: [clientId], references: [id], onDelete: SetNull)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  sessions      Session[]
  accounts      Account[]
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String   @unique
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}

/// A login method for a user: "credential" (email + password) or an OAuth provider like "google".
model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
}

/// Login attempt counters, stored in the database so limits hold across serverless instances.
model RateLimit {
  id          String @id
  key         String @unique
  count       Int
  lastRequest BigInt
}

// ─── Site content ───────────────────────────────────────────────────────────

/// Uploaded images, stored in the database so `pnpm db:export` carries them along.
/// Served at /media/<id>. Always re-encoded to WebP with metadata (EXIF, GPS) stripped.
model Media {
  id        String   @id @default(cuid())
  mimeType  String
  width     Int
  height    Int
  size      Int
  data      Bytes
  createdAt DateTime @default(now())
}

/// Editable site settings as JSON documents, e.g. "images" and "menus".
model SiteSetting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt
}

// ─── Blog ───────────────────────────────────────────────────────────────────

enum PostStatus {
  DRAFT
  PUBLISHED
}

/// A blog post. The text lives in one BlogPostTranslation per language; English is required.
model BlogPost {
  id           String                @id @default(cuid())
  slug         String                @unique
  status       PostStatus            @default(DRAFT)
  /// The date shown on the post.
  publishedAt  DateTime              @db.Date
  tag          String                @default("")
  /// Cover image: { id, width, height, alt? } pointing at a Media row.
  cover        Json?
  translations BlogPostTranslation[]
  createdAt    DateTime              @default(now())
  updatedAt    DateTime              @updatedAt

  @@index([status, publishedAt])
}

model BlogPostTranslation {
  id          String   @id @default(cuid())
  postId      String
  post        BlogPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  /// "en", "it" or "sq".
  locale      String
  title       String
  description String   @default("")
  /// Markdown.
  body        String
  updatedAt   DateTime @updatedAt

  @@unique([postId, locale])
}

// ─── Website builder: clients ───────────────────────────────────────────────

enum Plan {
  TRIAL
  STARTER
  PRO
  CUSTOM
}

/// A business using the website builder. Paid while paidUntil is today or later;
/// otherwise in the free trial until trialEndsAt, then locked (site offline).
model Client {
  id             String    @id @default(cuid())
  /// Business name, as the admin knows it.
  name           String
  /// Public address: appamora.com/s/<slug>.
  slug           String    @unique
  plan           Plan      @default(TRIAL)
  trialEndsAt    DateTime
  paidUntil      DateTime? @db.Date
  /// For Custom clients: the services they bought, one per line.
  customServices String[]  @default([])
  /// Private notes for the admin.
  notes          String    @default("")
  users          User[]
  site           Site?
  payments       Payment[]
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
}

/// A client's website: the chosen template and the editable content (brand, colors, home page, contact details…).
model Site {
  id          String        @id @default(cuid())
  clientId    String        @unique
  client      Client        @relation(fields: [clientId], references: [id], onDelete: Cascade)
  template    String        @default("web-agency")
  /// See src/lib/sites/content.ts.
  content     Json
  pages       SitePage[]
  messages    SiteMessage[]
  subscribers Subscriber[]
  updatedAt   DateTime      @updatedAt
}

model SitePage {
  id           String   @id @default(cuid())
  siteId       String
  site         Site     @relation(fields: [siteId], references: [id], onDelete: Cascade)
  /// "" for the home page.
  slug         String
  position     Int      @default(0)
  showInMenu   Boolean  @default(true)
  /// { en: { title, body }, it: … }; body is markdown.
  translations Json
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([siteId, slug])
}

/// Messages from the contact form on a client's site.
model SiteMessage {
  id        String   @id @default(cuid())
  siteId    String
  site      Site     @relation(fields: [siteId], references: [id], onDelete: Cascade)
  name      String
  email     String
  message   String
  read      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([siteId, createdAt])
}

/// People who signed up with the subscriber form on a client's site.
model Subscriber {
  id        String   @id @default(cuid())
  siteId    String
  site      Site     @relation(fields: [siteId], references: [id], onDelete: Cascade)
  email     String
  name      String   @default("")
  locale    String
  createdAt DateTime @default(now())

  @@unique([siteId, email])
}

enum PaymentMethod {
  PAYPAL
  CASH
}

enum PaymentStatus {
  PENDING
  COMPLETED
  CANCELLED
}

model Payment {
  id            String        @id @default(cuid())
  clientId      String
  client        Client        @relation(fields: [clientId], references: [id], onDelete: Cascade)
  method        PaymentMethod
  status        PaymentStatus @default(PENDING)
  plan          Plan
  months        Int
  /// Whole euros.
  amount        Int
  currency      String        @default("EUR")
  paypalOrderId String?       @unique
  /// The paid-until date this payment produced.
  periodEnd     DateTime?     @db.Date
  createdAt     DateTime      @default(now())
  completedAt   DateTime?

  @@index([status, createdAt])
}
