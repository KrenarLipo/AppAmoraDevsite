{
  "$schema": "https://turborepo.com/schema.json",
  "ui": "tui",
  "tasks": {
    "build": {
      "dependsOn": ["^build", "^generate"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "outputs": [".next/**", "!.next/cache/**", "dist/**"],
      "env": [
        "DATABASE_URL",
        "BETTER_AUTH_*",
        "GOOGLE_*",
        "RECAPTCHA_SECRET_KEY",
        "PAYPAL_*",
        "SMTP_*",
        "EMAIL_FROM",
        "ADMIN_NOTIFY_EMAIL",
        "NEXT_PUBLIC_*",
        "VERCEL_ENV",
        "VERCEL_PROJECT_PRODUCTION_URL"
      ],
      "cache": false
    },
    "generate": {
      "cache": false
    },
    "dev": {
      "dependsOn": ["^generate"],
      "cache": false,
      "persistent": true
    },
    "lint": {},
    "typecheck": {
      "dependsOn": ["^generate"]
    }
  }
}
