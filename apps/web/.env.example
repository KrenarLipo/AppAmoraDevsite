# Public URL of the site, used for canonical links, sitemap and Open Graph.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Local Docker database (pnpm db:up). In production use the Neon/Supabase pooled URL.
DATABASE_URL="postgresql://appamora:appamora@localhost:5434/appamora?schema=public"

# Auth — signs session cookies. Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=""
# The site's own URL. Required in production (https://appamora.com); leave empty locally so any port works.
BETTER_AUTH_URL=""

# Google login (optional) — https://console.cloud.google.com/apis/credentials
# Redirect URI: <BETTER_AUTH_URL>/api/auth/callback/google
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# reCAPTCHA v3 (optional) — https://www.google.com/recaptcha/admin
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=""
RECAPTCHA_SECRET_KEY=""

# PayPal (optional; without it clients can only choose cash) — https://developer.paypal.com/dashboard/applications
# Start with a Sandbox app (test money). Switch PAYPAL_ENV to "live" with the Live app's keys to take real payments.
PAYPAL_ENV="sandbox"
PAYPAL_CLIENT_ID=""
PAYPAL_CLIENT_SECRET=""
# The same value as PAYPAL_CLIENT_ID (loaded by the browser).
NEXT_PUBLIC_PAYPAL_CLIENT_ID=""

# Email (optional) — any mailbox's SMTP settings: GoDaddy cPanel, Zoho, Google Workspace, Brevo…
# Without them nothing is emailed; client activity still shows in the admin.
SMTP_HOST=""
SMTP_PORT="465"
SMTP_USER=""
SMTP_PASS=""
EMAIL_FROM="AppAmora <hello@appamora.com>"
# Where admin alerts go (client changes, payments). Defaults to the contact email in Site settings.
ADMIN_NOTIFY_EMAIL=""
